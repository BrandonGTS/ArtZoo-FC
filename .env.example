# Non-secret example only. Run bash scripts/init-local-env.sh yourself.
# PostgreSQL refuses an empty password. Never commit the generated .env.
POSTGRES_PASSWORD=

# Verified official public sources -> pending review only. Background collection is off by default.
ARTZOO_OFFICIAL_SYNC_ENABLED=0
ARTZOO_OFFICIAL_SYNC_INTERVAL_HOURS=24

# Public contact: set only the real approved administrator QQ, otherwise leave blank.

# 0 preserves authentication ephemera; set 1 only for an explicitly approved cleanup target.
ARTZOO_SECURITY_CLEANUP_ENABLED=0
