[Unit]
Description=ArtZoo daily offline backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=1000
Group=1000
SupplementaryGroups=docker
UMask=0077
# The fixed launcher follows deploy/current after upgrades and rollbacks.
ExecStart=/usr/local/libexec/artzoo-backup --root /srv/artzoo --backup-dir /srv/artzoo/backups --keep 7 --keep-maintenance 3
TimeoutStartSec=infinity
TimeoutStopSec=180
KillMode=mixed
StandardOutput=journal
StandardError=journal
