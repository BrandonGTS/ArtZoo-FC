# Copy to /srv/artzoo/secrets/compose.env on the runtime host; chmod 600.
# Pass images.env FIRST, then this file using two explicit --env-file options.
# Keep the project name stable across releases: it selects the PostgreSQL volume.
COMPOSE_PROJECT_NAME=artzoo
ARTZOO_MEDIA_ROOT=/srv/artzoo/media
ARTZOO_HTTP_PORT=13100

# Exact HTTPS origin, no path or trailing slash; fill in the fixed LAN address.
ARTZOO_PUBLIC_ORIGIN=
# Set caddy only after the real proxy overwrites forwarding headers (task 6).
ARTZOO_TRUSTED_PROXY=

# Generate separately, for example with: openssl rand -hex 32
# Use hexadecimal for POSTGRES_PASSWORD so DATABASE_URL needs no URL escaping.
# Changing this value does NOT change an already initialized database password.
POSTGRES_PASSWORD=
ARTZOO_INVITATION_KEY=

# Keep 0 until the offline media baseline succeeds against the checked database
# and persistent media directories. Then set 1 and recreate web and worker.
# Limits use decimal bytes: 10 GB total; 2 GB per account per Beijing calendar day.
# Changing limits never resets usage or deletes files. Do not disable to change limits.
ARTZOO_MEDIA_BUDGET_ENABLED=0
ARTZOO_MEDIA_GLOBAL_LIMIT_BYTES=10000000000
ARTZOO_MEDIA_DAILY_LIMIT_BYTES=2000000000

# Orphan deletion, QQ, official sync and SMS remain fixed off in Compose.
