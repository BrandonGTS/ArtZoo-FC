# Allow only build inputs. New top-level directories are excluded by default.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.node-version
!tsconfig.base.json
!patches/
!patches/**
!scripts/
!scripts/**
!assets/
!assets/**
!apps/
!apps/web/
!apps/web/**
!apps/worker/
!apps/worker/**
!packages/
!packages/domain/
!packages/domain/**
!packages/db/
!packages/db/**
!packages/media/
!packages/media/**

# Host dependencies and generated output are rebuilt inside the image.
**/node_modules
**/.pnpm-store
**/.next
**/dist
**/out
**/build
**/.cache
**/coverage
**/*.tsbuildinfo
**/next-env.d.ts
packages/db/src/generated

# Keep public/ and assets/: checked-in images, optimized resources, fonts and
# manifests are required by prepare-static-assets.mjs and prepare-stickers.mjs.

# Always exclude private configuration, including files inside allowed trees.
**/.git
**/.github
**/.gitignore
**/.npmignore
**/.npmrc
**/.yarnrc*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.local
**/secrets
**/.aws
**/.ssh
**/.codex
**/.agents
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*

# Runtime data and execution evidence never belong in an image.
**/storage
**/uploads
**/backups
**/pgdata
**/*.dump
**/*.backup
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.log
**/*.tap
**/*.har
**/__pycache__
**/*.pyc
**/.DS_Store
