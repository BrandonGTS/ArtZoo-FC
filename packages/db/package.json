{
  "name": "@artzoo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lottery-eligibility": {
      "types": "./dist/lottery-eligibility.d.ts",
      "import": "./dist/lottery-eligibility.js"
    },
    "./transaction-retry": {
      "types": "./dist/transaction-retry.d.ts",
      "import": "./dist/transaction-retry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "@artzoo/domain": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@types/pg": "8.23.1"
  }
}
