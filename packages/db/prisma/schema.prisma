  profile MemberProfile?
  avatarAssets AvatarAsset[]
  sessions AccountSession[]
  invitations Invitation[] @relation("InvitationCreator")
  usedInvitation Invitation? @relation("InvitationUser")
  auditActions AccountAudit[] @relation("AuditActor")
  auditTargets AccountAudit[] @relation("AuditTarget")
  @@unique([gameServer, displayName])
  @@index([createdAt, id])
  albums Album[]
  albumPhotos AlbumPhoto[]
  albumComments AlbumComment[]
  albumCommentMedia AlbumCommentMedia[]
  albumCommands AlbumCommand[]
  albumLikes AlbumLike[]
  albumAudits AlbumAudit[]
  albumNotifications AlbumNotification[]
  dailyCheckins DailyCheckin[]
  siteHelpStepProgress SiteHelpStepProgress[]
