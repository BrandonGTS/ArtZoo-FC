 lifecycleCommands AccountLifecycleCommand[] @relation("LifecycleCommandActor")
 lifecycleCommandTargets AccountLifecycleCommand[] @relation("LifecycleCommandTarget")
 lifecycleAudits AccountLifecycleAudit[] @relation("LifecycleAuditActor")
 lifecycleAuditTargets AccountLifecycleAudit[] @relation("LifecycleAuditTarget")
  adminRoleRevision Int @default(0)
  managementCommands AdminManagementCommand[]
  managementAudits AdminManagementAudit[] @relation("ManagementAuditActor")
  managementTargets AdminManagementAudit[] @relation("ManagementAuditTarget")
 activityShares ActivityShare[]
 activityShareMedia ActivityShareMedia[]
 activityShareAudits ActivityShareAudit[]
 activityShareCommands ActivityShareCommand[]
  officialEventAudits OfficialEventAudit[]
  officialEventCommands OfficialEventCommand[]
  officialSyncRuns OfficialSyncRun[]
 wishCommands WishCommand[]
 wishMedia WishMedia[]
 wishes Wish[] @relation("WishAuthor")
 wishInterests WishInterest[] @relation("WishInterestedAccount")
 wishComments WishComment[] @relation("WishCommentAuthor")
 wishConversions WishConversion[] @relation("WishConversionActor")
 wishNotifications WishNotification[] @relation("WishNotificationRecipient")
 lotteries Lottery[]
 lotteryEntries LotteryEntry[]
 lotteryCommands LotteryCommand[]
 lotteryNotifications LotteryNotification[]
 lotteryStatus LotteryAccountStatus? @relation("LotteryStatusAccount")
 lotteryStatusChanges LotteryAccountStatus[] @relation("LotteryStatusActor")
 lotteryFacts LotteryAccountFact[] @relation("LotteryFactAccount")
 lotteryFactChanges LotteryAccountFact[] @relation("LotteryFactActor")
  dailyPosts DailyPost[]
  dailyComments DailyComment[]
  dailyMedia DailyMedia[]
  dailyLikes DailyLike[]
  dailyCommands DailyCommand[]
  dailyNotifications DailyNotification[]
  dailyAudits DailyAudit[]
  knowledgeInteractions KnowledgeArticleInteraction[]
  knowledgeImages KnowledgeImage[] @relation("KnowledgeImageUploader")
  knowledgeArticles KnowledgeArticle[] @relation("KnowledgeAuthor")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeEditor")
  knowledgeContributions KnowledgeContribution[] @relation("KnowledgeContributor")
  knowledgeComments KnowledgeComment[] @relation("KnowledgeCommentAuthor")
  knowledgeNotifications KnowledgeNotification[] @relation("KnowledgeRecipient")
  knowledgeAudits KnowledgeAudit[] @relation("KnowledgeAuditActor")
  id String @id @default(uuid())
  phone String @unique
  passwordHash String
  passwordVersion Int @default(0)
  displayName String?
  gameRegion String?
  gameServer String?
  membership Membership
  adminRole AdminRole @default(NONE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ownedTeams FixedTeam[]
  teamMemberships TeamMembership[]
  teamApplications TeamApplication[]
  teamFeedback TeamFeedback[]
  teamSessionMemberships TeamSessionMember[]
  teamParticipationChanges TeamParticipationChange[]
  teamLeaveRecords TeamSessionLeave[]
  teamSubstitutions TeamSessionSubstitute[] @relation("TeamSubstitutePerson")
  teamRecordedSubstitutions TeamSessionSubstitute[] @relation("TeamSubstituteRecorder")
  teamCommands TeamCommand[]
  teamNotifications TeamNotification[]
  activities Activity[]
  activityRegistrations ActivityRegistration[]
  activityNotifications ActivityOutbox[]
  activityCommands ActivityCommand[]
  activityPenalties ActivityPenalty[]
  activityScoreChanges ActivityScoreChange[]
  activityCompletions ActivityCompletion[]
  penaltyAppeals ActivityPenaltyAppeal[] @relation("PenaltyAppealOwner")
  penaltyDecisions ActivityPenaltyAppeal[] @relation("PenaltyAppealReviewer")
  attendanceAppeals ActivityAttendanceAppeal[] @relation("AppealOwner")
  attendanceDecisions ActivityAttendanceAppeal[] @relation("AppealReviewer")
  activityPoints Int @default(0)
  activityDecayAt DateTime? @db.Timestamptz(3)
