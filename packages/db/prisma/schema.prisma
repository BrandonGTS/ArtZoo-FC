model AccountSession {
  id String @id @default(uuid())
  tokenHash String @unique
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([accountId, revokedAt])
  @@index([expiresAt])
}
enum InvitationUsageMode {
  SINGLE
  MULTIPLE
}
model Invitation {
  usageMode InvitationUsageMode @default(SINGLE)
  tokenCiphertext String?
  id String @id @default(uuid())
  tokenHash String @unique
  membership Membership
  createdById String
  createdBy Account @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  usedById String? @unique
  usedBy Account? @relation("InvitationUser", fields: [usedById], references: [id], onDelete: Restrict)
  revokedAt DateTime? @db.Timestamptz(3)
  removedAt DateTime? @db.Timestamptz(3)
  codes VerificationCode[]
  audits AccountAudit[]
  @@index([createdAt, id])
}
model VerificationCode {
  id String @id @default(uuid())
  phone String
  purpose VerificationPurpose
  invitationId String?
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  codeHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  attempts Int @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  @@index([phone, createdAt])
}
model AccountRateEvent {
  id String @id @default(uuid())
  key String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([key, createdAt])
}
model AccountAudit {
  id String @id @default(uuid())
  action String
  actorId String
  actor Account @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetAccountId String?
  targetAccount Account? @relation("AuditTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  invitationId String?
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  beforeMembership Membership?
  afterMembership Membership?
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt, id])
  @@index([action, createdAt, id])
}

model MemberProfile {
  accountId String @id
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  bio String @default("")
  commonJobs String[] @default([])
  preferredPlaystyles String[] @default([])
  revision Int @default(0)
  avatarId String? @unique
  avatar AvatarAsset? @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model AvatarAsset {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  width Int
  height Int
  bytes Int
  smallBytes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  profile MemberProfile?
  @@index([accountId])
}

enum ActivityScene {
  GAME
  OFFLINE
}
enum ActivityMode {
  SINGLE
  SERIES
}
enum ActivityCategory {
  DUNGEON
  SOCIAL
}
enum ActivitySeatKind {
  ANY
  ROLE
  JOB
}
enum ActivityRole {
  TANK
  HEALER
  DAMAGE
}
enum ActivityEventKind {
  REGISTRATION_CONFIRMED
  SERIES_READY
  SERIES_FORMED
  ACTIVITY_PUBLISHED
  REGISTRATION_CREATED
  REGISTRATION_WITHDRAWN
  ACTIVITY_RESCHEDULED
  ACTIVITY_CANCELLED
  ACTIVITY_PENALTY
  ACTIVITY_SCORE_CORRECTED
  ATTENDANCE_APPEAL_RESULT
  ACTIVITY_COMPLETED
  PENALTY_APPEAL_RESULT
}
enum ActivityNotificationChannel {
  QQ
  IN_APP
}
model ActivitySeries {
  id String @id @default(uuid())
  state String @default("RECRUITING")
  weekdays Int[]
  durationMinutes Int
  totalPeriods Int
  endDate String?
  formedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  readyNotifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  activities Activity[]
  @@index([state, createdAt])
  albums Album[]
}
model Activity {
  officialDeliveries QqOfficialDelivery[]
 publicShares ActivityShare[]
 sourceWish Wish? @relation("WishLinkedActivity")
 wishConversion WishConversion? @relation("WishConvertedActivity")
 wishNotifications WishNotification[] @relation("WishNotificationActivity")
  scene ActivityScene @default(GAME)
  mode ActivityMode @default(SINGLE)
  location String?
  meetingInstructions String?
  registrationClosesAt DateTime? @db.Timestamptz(3)
  capacityUnlimited Boolean @default(false)
  seriesId String?
  series ActivitySeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  periodNumber Int?

  id String @id @default(uuid())
  organizerId String
  organizer Account @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  idempotencyKey String
  requestFingerprint String
  title String
  description String
  category ActivityCategory
  dutyId String?
  dutySnapshot Json?
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  managementEnabledAt DateTime @default(now()) @db.Timestamptz(3)
  attendanceEnabledAt DateTime @default(now()) @db.Timestamptz(3)
  autoAbsenceEnabledAt DateTime? @default(now()) @db.Timestamptz(3)
  completionEnabledAt DateTime? @default(now()) @db.Timestamptz(3)
  completions ActivityCompletion[]
  revision Int @default(0)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancellationReason String?
  continuedAt DateTime? @db.Timestamptz(3)
  commands ActivityCommand[]
  penalties ActivityPenalty[]
  seats ActivitySeat[]
  registrations ActivityRegistration[]
  events ActivityOutbox[]
  @@unique([seriesId, periodNumber])
  @@unique([organizerId, idempotencyKey])
  @@index([startsAt, id])
  linkedAlbums Album[] @relation("AlbumAnchor")
  albumPeriodPhotos AlbumPhoto[] @relation("AlbumPeriod")
}
model ActivitySeat {
  id String @id @default(uuid())
  activityId String
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  position Int
  kind ActivitySeatKind
  groupKey String?
  role ActivityRole?
  job String?
  registration ActivityRegistration?
  @@unique([activityId, position])
  @@unique([id, activityId])
}
model ActivityRegistration {
  id String @id @default(uuid())
  activityId String
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  seatId String? @unique
  seat ActivitySeat? @relation(fields: [seatId, activityId], references: [id, activityId], onDelete: Restrict)
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  job String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  status String @default("ACTIVE")
  exitedAt DateTime? @db.Timestamptz(3)
  seatSnapshot Json?
  rescheduleExitAllowed Boolean @default(false)
  attendanceStatus String?
  attendanceSource String?
  attendanceRevision Int @default(0)
  attendanceRecordedAt DateTime? @db.Timestamptz(3)
  attendanceUpdatedAt DateTime? @db.Timestamptz(3)
  // Partial ActivityRegistration_pending_attendance_idx is SQL-only: ACTIVE with all pending attendance columns NULL.
  attendancePenaltyId String? @unique
  attendancePenalty ActivityPenalty? @relation("CurrentAttendancePenalty", fields: [attendancePenaltyId], references: [id], onDelete: Restrict)
  attendanceAppeals ActivityAttendanceAppeal[]
  completion ActivityCompletion?
  events ActivityOutbox[]
  penalties ActivityPenalty[]
  @@index([activityId, accountId])
  @@unique([seatId, activityId])
  @@index([accountId, createdAt])
}
model ActivityOutbox {
  id String @id @default(uuid())
  eventKey String @unique
  activityId String
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  registrationId String?
  registration ActivityRegistration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  kind ActivityEventKind
  payload Json?
  channel ActivityNotificationChannel
  recipientId String?
  recipient Account? @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  messageDeletedAt DateTime? @db.Timestamptz(3)
  messageReadAt DateTime? @db.Timestamptz(3)
  mockDelivery ActivityMockDelivery?
  @@index([recipientId, createdAt])
  @@index([recipientId, channel, messageReadAt, createdAt, id], map: "ActivityOutbox_recipientId_channel_messageReadAt_createdAt_id_i")
}
model ActivityMockDelivery {
  id String @id @default(uuid())
  eventId String @unique
  event ActivityOutbox @relation(fields: [eventId], references: [id], onDelete: Restrict)
  deliveredAt DateTime @default(now()) @db.Timestamptz(3)
}

model ActivityCommand {
  id String @id @default(uuid())
  activityId String
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  actorId String?
  actor Account? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey String
  requestFingerprint String
  kind String
  before Json
  after Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([activityId, actorId, idempotencyKey])
  @@index([activityId, createdAt])
}
model ActivityPenalty {
  id String @id @default(uuid())
  eventKey String @unique
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  activityId String
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  registrationId String?
  registration ActivityRegistration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  scoreChange ActivityScoreChange?
  attendanceRegistration ActivityRegistration? @relation("CurrentAttendancePenalty")
  appeals ActivityPenaltyAppeal[]
  appealEnabledAt DateTime? @default(now()) @db.Timestamptz(3)
  reversedAt DateTime? @db.Timestamptz(3)
  reversalReason String?
  points Int
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([accountId, createdAt])
}

model ActivityScoreChange {
  sequence BigInt @unique @default(autoincrement())
  decayBefore DateTime? @db.Timestamptz(3)
  decayAfter DateTime? @db.Timestamptz(3)
  id String @id @default(uuid())
  eventKey String @unique
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  penaltyId String? @unique
  penalty ActivityPenalty? @relation(fields: [penaltyId], references: [id], onDelete: Restrict)
  completionId String? @unique
  completion ActivityCompletion? @relation(fields: [completionId], references: [id], onDelete: Restrict)
  delta Int
  pointsBefore Int
  pointsAfter Int
  reason String
  messageDeletedAt DateTime? @db.Timestamptz(3)
  messageReadAt DateTime? @db.Timestamptz(3)
  notices String[] @default([])
  simulatedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([accountId, createdAt])
  @@index([accountId, messageReadAt, createdAt, id])
}

model ActivityAttendanceAppeal {
  id String @id @default(uuid())
  registrationId String
  registration ActivityRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  accountId String
  account Account @relation("AppealOwner", fields: [accountId], references: [id], onDelete: Restrict)
  attendanceRevision Int
  requestedStatus String
  reason String
  status String @default("PENDING")
  revision Int @default(0)
  decisionReason String?
  decidedById String?
  decidedBy Account? @relation("AppealReviewer", fields: [decidedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  decidedAt DateTime? @db.Timestamptz(3)
  @@index([status, createdAt, id])
  @@index([registrationId, createdAt, id])
}

model ActivityCompletion {
  id String @id @default(uuid())
  activityId String
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  registrationId String @unique
  registration ActivityRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  active Boolean
  revision Int @default(0)
  evaluatedAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  scoreChange ActivityScoreChange?
  @@unique([activityId, accountId])
}

model ActivityPenaltyAppeal {
  id String @id @default(uuid())
  sequence BigInt @unique @default(autoincrement())
  penaltyId String
  penalty ActivityPenalty @relation(fields: [penaltyId], references: [id], onDelete: Restrict)
  accountId String
  account Account @relation("PenaltyAppealOwner", fields: [accountId], references: [id], onDelete: Restrict)
  reason String
  submissionKey String
  submissionFingerprint String
  decisionKey String?
  decisionFingerprint String?
  status String @default("PENDING")
  revision Int @default(0)
  decisionReason String?
  decidedById String?
  decidedBy Account? @relation("PenaltyAppealReviewer", fields: [decidedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  decidedAt DateTime? @db.Timestamptz(3)
  @@unique([accountId, submissionKey])
  @@unique([decidedById, decisionKey])
  @@index([status, createdAt, sequence])
  @@index([penaltyId, sequence])
}

